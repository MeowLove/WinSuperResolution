<Window x:Class="WinSuperResolution.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Ui[ProductName]}" Height="820" Width="1320" MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#17212B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5D6B78" />
        <SolidColorBrush x:Key="AccentBrush" Color="#087E8B" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#056773" />
        <SolidColorBrush x:Key="OutlineBrush" Color="#D8E0E6" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#AEBBC4" />
                                <Setter Property="Foreground" Value="#EEF2F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E8EEF1" />
            <Setter Property="Foreground" Value="#24404A" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#24525A" />
            <Setter Property="Foreground" Value="#F7FCFC" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EDF0" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3F5" />
            <Setter Property="Foreground" Value="#51616E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="BorderBrush" Value="#DCE5E9" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="18,18,18,14" Padding="24,20" Background="#143D43" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Ui[ProductName]}" Foreground="White" FontSize="29" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Ui[Subtitle]}" Foreground="#C8DBDE" FontSize="14" Margin="0,4,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Ui[Refresh]}" Style="{StaticResource HeaderButton}" Click="RefreshButton_Click" />
                        <Button Content="{Binding Ui[DisplaySettings]}" Style="{StaticResource HeaderButton}" Click="DisplaySettingsButton_Click" />
                        <Button Content="{Binding Ui[CopyDiagnostic]}" Style="{StaticResource HeaderButton}" Click="CopyDiagnosticButton_Click" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Width="150">
                    <TextBlock Text="{Binding Ui[Language]}" Foreground="#C8DBDE" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Ui[RegisteredConfigurations]}" Foreground="{StaticResource InkBrush}" FontSize="17" FontWeight="SemiBold" Margin="16,16,16,4" />
                    <TextBlock Grid.Row="1" Text="{Binding Ui[DisplayRecordsHint]}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="16,0,16,12" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding DataContext.Ui[Status], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ConnectionStatus}" Width="82" />
                            <DataGridTextColumn Header="{Binding DataContext.Ui[Display], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding DisplayIdentity}" Width="*" />
                            <DataGridTextColumn Header="{Binding DataContext.Ui[Surface], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding PrimarySurfaceText}" Width="102" />
                            <DataGridTextColumn Header="{Binding DataContext.Ui[Signal], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ActiveSignalText}" Width="96" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="7" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Ui[CurrentState]}" Foreground="{StaticResource InkBrush}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentStateSummary}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,8,0,4" />
                            <TextBlock Text="{Binding Ui[CurrentStateGuard]}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            <Border Background="#FFF7ED" BorderBrush="#F1C48E" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Ui[ExperimentalScale]}" Foreground="#8A4A0B" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ScaleAvailability}" Foreground="#704015" TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Width="105" ItemsSource="{Binding AvailableScalePercentages}" SelectedItem="{Binding SelectedScalePercent}" IsEnabled="{Binding CanApplyExperimentalScale}" />
                                        <Button Content="{Binding Ui[ApplyScale]}" Click="ApplyScaleButton_Click" IsEnabled="{Binding CanApplyExperimentalScale}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DockPanel Margin="0,14,0,0">
                                <Button DockPanel.Dock="Right" Content="{Binding Ui[ApplyMode]}" Click="ApplyModeButton_Click" IsEnabled="{Binding CanManageCurrentState}" Margin="8,0,0,0" />
                                <ComboBox ItemsSource="{Binding CurrentModes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="DisplayText" IsEnabled="{Binding CanManageCurrentState}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Ui[AvailableModes]}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="7" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Ui[CapabilityPlan]}" Foreground="{StaticResource InkBrush}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Ui[Magnification]}" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                                <ComboBox Width="96" Margin="8,0,8,0" ItemsSource="{Binding MagnificationOptions}" SelectedItem="{Binding SelectedMagnification}" />
                                <Button Content="{Binding Ui[BuildPlan]}" Style="{StaticResource QuietButton}" Click="BuildPlanButton_Click" />
                            </StackPanel>
                            <TextBlock Text="{Binding PlanSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="{Binding Ui[ApplySelected]}" Click="ApplySelectedButton_Click" />
                                <Button Content="{Binding Ui[ApplyAll]}" Style="{StaticResource QuietButton}" Click="ApplyAllButton_Click" />
                                <Button Content="{Binding Ui[RestoreLatest]}" Style="{StaticResource QuietButton}" Click="RestoreLatestButton_Click" />
                            </WrapPanel>
                            <Border Background="#F1F7F8" BorderBrush="#BFD9DE" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,14,0,0">
                                <TextBlock Text="{Binding Ui[CapabilityWarning]}" Foreground="#315A62" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="7" Padding="18">
                        <StackPanel>
                            <TextBlock Text="{Binding Ui[Recovery]}" Foreground="{StaticResource InkBrush}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Ui[RecoveryLocation]}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,2" />
                            <TextBlock Text="{Binding RecoveryDataPath}" ToolTip="{Binding RecoveryDataPath}" Foreground="#245A65" TextTrimming="CharacterEllipsis" />
                            <Button Content="{Binding Ui[OpenRecoveryFolder]}" Style="{StaticResource QuietButton}" Click="OpenRecoveryFolderButton_Click" HorizontalAlignment="Left" Margin="0,10,0,10" />
                            <Separator Background="#E4EAED" />
                            <TextBlock Text="{Binding LastOperationSummary}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#E7ECEF" Margin="18,14,18,18" Padding="10,7" CornerRadius="5">
            <TextBlock Text="{Binding StatusText}" Foreground="#41525D" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
